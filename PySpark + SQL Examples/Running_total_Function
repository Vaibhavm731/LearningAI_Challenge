data = [("2024-01-01", 100), ("2024-01-02", 200), ("2024-01-03", 150), ("2024-01-04", 250)]
columns = ["order_date", "amount"]      

df = spark.createDataFrame(data, columns)
window_spec = window.orderBy('order_date').rowsBetween(Window.unboundedPreceding, Window.currentRow)

# If we have multiple categories and want to calculate the cumulative sales for each category separately, we can define the window specification as follows:
window_spec = Window.partitionBy("sales").orderBy('order_date').rowsBetween(Window.unboundedPreceding, Window.currentRow)


from pyspark.sql import functions as F
df = df.withColumn("running_total", F.sum("amount").over(window_spec))
df.show()
